
import pandas as pd
from sklearn.linear_model import LinearRegression

# Sample dataset
data = {
    "Area": [600, 800, 1000, 1200, 1500, 1800],
    "Rooms": [1, 2, 2, 3, 3, 4],
    "Location": [1, 2, 2, 3, 3, 4],   # 1=Outskirts, 2=Town, 3=City, 4=Prime
    "Rent": [10000, 15000, 18000, 25000, 30000, 38000]
}

df = pd.DataFrame(data)

# Features and target
X = df[["Area", "Rooms", "Location"]]
y = df["Rent"]

# Train model
model = LinearRegression()
model.fit(X, y)

# New apartment details
new_apartment = pd.DataFrame({
    "Area": [1300],
    "Rooms": [3],
    "Location": [3]
})

# Predict rent
predicted_rent = model.predict(new_apartment)

print("Predicted Rent: ₹", round(predicted_rent[0], 2))
