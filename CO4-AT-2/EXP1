# Q1: Fraud Detection using Bayesian Network

from itertools import product
from pgmpy.models import DiscreteBayesianNetwork
from pgmpy.factors.discrete import TabularCPD
from pgmpy.inference import VariableElimination

# 1. Construct Bayesian Network
model = DiscreteBayesianNetwork([
    ('Amount', 'Fraud'),
    ('Location', 'Fraud'),
    ('Device', 'Fraud'),
    ('History', 'Fraud')
])

# Root variable CPTs
cpd_amount = TabularCPD(
    variable='Amount', variable_card=2,
    values=[[0.7], [0.3]],
    state_names={'Amount': ['Low', 'High']}
)

cpd_location = TabularCPD(
    variable='Location', variable_card=2,
    values=[[0.8], [0.2]],
    state_names={'Location': ['Known', 'Unknown']}
)

cpd_device = TabularCPD(
    variable='Device', variable_card=2,
    values=[[0.75], [0.25]],
    state_names={'Device': ['Trusted', 'New']}
)

cpd_history = TabularCPD(
    variable='History', variable_card=2,
    values=[[0.85], [0.15]],
    state_names={'History': ['No', 'Yes']}
)

# 2. Fraud CPT
# Columns represent all combinations of:
# Amount, Location, Device, History

combinations = list(product(
    ['Low', 'High'],
    ['Known', 'Unknown'],
    ['Trusted', 'New'],
    ['No', 'Yes']
))

fraud_probabilities = []

for amount, location, device, history in combinations:
    probability = 0.02

    if amount == 'High':
        probability += 0.15
    if location == 'Unknown':
        probability += 0.20
    if device == 'New':
        probability += 0.15
    if history == 'Yes':
        probability += 0.30

    probability = min(probability, 0.95)
    fraud_probabilities.append(probability)

cpd_fraud = TabularCPD(
    variable='Fraud',
    variable_card=2,
    values=[
        [1 - p for p in fraud_probabilities],
        fraud_probabilities
    ],
    evidence=['Amount', 'Location', 'Device', 'History'],
    evidence_card=[2, 2, 2, 2],
    state_names={
        'Fraud': ['No', 'Yes'],
        'Amount': ['Low', 'High'],
        'Location': ['Known', 'Unknown'],
        'Device': ['Trusted', 'New'],
        'History': ['No', 'Yes']
    }
)

# Add CPTs
model.add_cpds(
    cpd_amount,
    cpd_location,
    cpd_device,
    cpd_history,
    cpd_fraud
)

# Check model
print("Bayesian Network valid:", model.check_model())

# 3. Perform inference
inference = VariableElimination(model)

result = inference.query(
    variables=['Fraud'],
    evidence={
        'Amount': 'High',
        'Location': 'Unknown',
        'Device': 'New',
        'History': 'Yes'
    }
)

print("\nFraud Prediction:")
print(result)

fraud_probability = result.values[1]

print("\nProbability of Fraud:", round(fraud_probability, 4))

if fraud_probability >= 0.5:
    print("Prediction: FRAUDULENT TRANSACTION")
else:
    print("Prediction: LEGITIMATE TRANSACTION")

# 4. Interpretation
print("\nInterpretation:")
print("The Bayesian Network combines transaction amount, location,")
print("device and previous fraud history to estimate fraud probability.")
print("This helps banks identify risky transactions and reduce financial losses.")
