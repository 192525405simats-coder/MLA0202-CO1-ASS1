import random

def monte_carlo_delivery(num_simulations):
    on_time_count = 0

    for _ in range(num_simulations):
        # Generate random delivery conditions
        traffic = random.uniform(0, 1)
        weather = random.uniform(0, 1)
        driver_efficiency = random.uniform(0, 1)

        # Simulate delivery
        # Higher traffic/weather values make delivery harder.
        delivery_score = (
            0.5 * driver_efficiency
            + 0.3 * (1 - traffic)
            + 0.2 * (1 - weather)
        )

        # Delivery is on-time if score is above threshold
        if delivery_score >= 0.5:
            on_time_count += 1

    probability = on_time_count / num_simulations

    print("Number of simulations:", num_simulations)
    print("On-time deliveries:", on_time_count)
    print("Estimated probability of on-time delivery:", probability)

    return probability


# Run simulation
monte_carlo_delivery(10000)
