import random

def td_learning(num_episodes, alpha=0.1, gamma=0.9):
    # Initialize state-value estimates
    V = {}

    for episode in range(num_episodes):

        # Initial state
        state = 0

        while state != 4:

            # Initialize unseen states
            if state not in V:
                V[state] = 0.0

            # Simulate next state
            next_state = state + 1

            # Give reward when reaching terminal state
            if next_state == 4:
                reward = 10
            else:
                reward = 0

            # Initialize next state
            if next_state not in V:
                V[next_state] = 0.0

            # TD update
            V[state] = V[state] + alpha * (
                reward + gamma * V[next_state] - V[state]
            )

            # Move to next state
            state = next_state

    print("Learned State Values:")

    for state, value in V.items():
        print("State", state, ":", round(value, 3))

    return V


# Run TD learning
td_learning(
    num_episodes=1000,
    alpha=0.1,
    gamma=0.9
)
